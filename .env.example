MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
EMBEDDING_SERVICE_URL=http://localhost:8010
RUN_INTEGRATION_TESTS=0

# Worker auth token (shared secret between backend and worker-scoring)
WORKER_INTERNAL_TOKEN=dev-worker-token

# JWT Config
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────
# Email Notifications (worker-notification)
# ──────────────────────────────────────────
# Leave SMTP_HOST blank to run in no-op / log-only mode.
# Fill in to enable real email delivery.

# Generic SMTP (works with Gmail, Outlook, SendGrid, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   # use Google App Password, not your login password

# SendGrid SMTP example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxx

# Sender address shown to recipients
SMTP_FROM="CV Matching Platform <noreply@cv-matching.local>"

# Base URL for CTA links in emails (e.g. "View Application")
APP_BASE_URL=http://localhost:3000

# Brand color for email header background (hex)
BRAND_PRIMARY_COLOR=#1D4ED8
