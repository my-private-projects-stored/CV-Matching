MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
# Base64-only characters ([A-Za-z0-9+/=]) required by MongoDB --keyFile
MONGO_REPLICA_KEY=cvmDevReplicaSetKey0123456789abcdef0123456789abcdef
# Set MONGO_HOST_PORT=27018 if host port 27017 is already in use
MONGO_HOST_PORT=27017
EMBEDDING_SERVICE_URL=http://localhost:8010
RUN_INTEGRATION_TESTS=0

# MinIO Object Storage (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_RESUMES_BUCKET=resumes-bucket
MINIO_ASSETS_BUCKET=company-assets-bucket

# Security & Encryption
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker auth token (shared secret between backend and worker-scoring)
WORKER_INTERNAL_TOKEN=dev-worker-token
GATEWAY_INTERNAL_SECRET=dev-gateway-secret

# JWT Config
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────
# Email Notifications (worker-notification)
# ──────────────────────────────────────────
# Leave SMTP_HOST blank to run in no-op / log-only mode.
# Fill in to enable real email delivery.

# Generic SMTP (works with Gmail, Outlook, SendGrid, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   # use Google App Password, not your login password

# SendGrid SMTP example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxx

# Sender address shown to recipients
SMTP_FROM="CV Matching Platform <noreply@cv-matching.local>"

# Base URL for CTA links in emails (e.g. "View Application")
APP_BASE_URL=http://localhost:3000

# Brand color for email header background (hex)
BRAND_PRIMARY_COLOR=#1D4ED8
